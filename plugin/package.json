{
  "name": "@oh-my-aihub/magpie-plugin",
  "version": "0.6.0",
  "description": "Magpie plugin: EasyTier no-TUN supervisor and Gateway Key provisioner for private AI sharing",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:page": "bun scripts/build-page.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^5.9.0"
  },
  "magpie": {
    "page": {
      "title": "Oh My AIHub",
      "file": "page/index.html",
      "icon": "page/icon.svg"
    },
    "permissions": []
  },
  "files": [
    "bin/",
    "src/",
    "console/",
    "page/index.html",
    "page/app.js",
    "page/settings.js",
    "page/style.css",
    "page/icon.svg",
    "README.md"
  ],
  "dependencies": {
    "ethers": "6.17.0"
  }
}
