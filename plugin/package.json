{
  "name": "@oh-my-aihub/magpie-plugin",
  "version": "0.5.0",
  "description": "Magpie plugin: EasyTier no-TUN supervisor and Gateway Key provisioner for private AI sharing",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "test": "bun test ./test ./console ../docs/validation/lab/phase9/wallet-fixture",
    "typecheck": "tsc --noEmit",
    "boot-check": "bun run scripts/boot-check.ts",
    "secret-scan": "bun run scripts/secret-scan.ts",
    "ci": "bun run typecheck && bun run test && bun run boot-check && bun run secret-scan"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "playwright": "1.64.1",
    "typescript": "^5.9.0"
  },
  "magpie": {
    "page": {
      "title": "Oh My AIHub",
      "file": "page/index.html",
      "icon": "page/icon.svg"
    },
    "permissions": []
  },
  "files": [
    "bin/",
    "src/",
    "console/",
    "page/index.html",
    "page/app.js",
    "page/settings.js",
    "page/style.css",
    "page/icon.svg",
    "README.md"
  ]
}
